# Fashion Bazar admin panel settings.
# Copy to .env.local for local development. For the live admin, set the same variables on your
# hosting platform (Vercel > Settings > Environment Variables).
#
# NEXT_PUBLIC_ variables are built into the page and anyone can see them,
# so never put a secret here. Rebuild (`npm run build`) after changing them.

# The backend's address + /api (no trailing slash).
# Production example: https://api.fashionbazar.in/api
NEXT_PUBLIC_API_URL=http://localhost:3200/api

# The shop's address, used for the "View in store" links on product pages.
# Production example: https://fashionbazar.in
NEXT_PUBLIC_STORE_URL=http://localhost:5173
